# Copy to .env and adjust. Read by docker-compose.yml.

# PostgreSQL account used by Noosphere (the database container creates it).
POSTGRES_USER=noosphere
POSTGRES_PASSWORD=change-me

# true: load the "Alizé" demo landscape and the accounts alice (admin), bob (member) and claire (guest),
# all with the password "demo". Never on a shared server.
NOOSPHERE_DEMO=false

# First administrator, created on the first start when there is no account.
# Empty password: a random one is printed once in the logs (docker compose logs noosphere).
NOOSPHERE_ADMIN_USERNAME=admin
NOOSPHERE_ADMIN_PASSWORD=

# Sign-in attempts allowed per minute and per client address.
NOOSPHERE_LOGIN_RATE_LIMIT=10

# Name and public address of this instance, written in exports (source.name, source.url).
# The name is a default: administrators can change it in the settings.
NOOSPHERE_INSTANCE_NAME=Noosphere
NOOSPHERE_PUBLIC_URL=

# Networks of the HTTPS reverse proxy allowed to send X-Forwarded-For / X-Forwarded-Proto (comma-separated).
NOOSPHERE_TRUSTED_PROXIES=172.16.0.0/12

# Days the access log (reads of restricted records and protected notes, full exports) is kept.
NOOSPHERE_ACCESS_LOG_DAYS=365

# Days the AI agents' activity is kept, and OAuth client registrations allowed per minute and per address.
NOOSPHERE_AGENT_ACTIVITY_DAYS=90
NOOSPHERE_REGISTRATION_RATE_LIMIT=20

# Preset pairing code for a gestion-mep instance started together: at least 16 letters or digits, single use,
# valid 24 hours after start (see docs/en/links.md). Give the same value to gestion-mep as NOOSPHERE_CODE_LIAISON.
NOOSPHERE_LINK_BOOTSTRAP_CODE=

# Address and port published on the host. 127.0.0.1: only a reverse proxy on the same machine can reach it.
NOOSPHERE_BIND=127.0.0.1
NOOSPHERE_PORT=8080
